# ===================================
# ParkWhizz Application Configuration
# ===================================
# Copy this file to application.properties and fill in your values
# NEVER commit application.properties to Git!

# Server Configuration
server.port=9090

# MongoDB Configuration
# Get this from MongoDB Atlas: https://cloud.mongodb.com
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
spring.data.mongodb.uri=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/Parkwhizz?retryWrites=true&w=majority
spring.data.mongodb.auto-index-creation=true

# Logging
logging.level.org.springframework.security=INFO

# Spring Security Basic Auth (for development/testing)
spring.security.user.name=admin
spring.security.user.password=admin123

# Firebase Configuration (for push notifications)
firebase.config.path=parkbuzzPushNotification.json

# ===================================
# Email Configuration
# ===================================
# Option 1: SendGrid (Recommended for production)
# Sign up at: https://sendgrid.com
# spring.mail.host=smtp.sendgrid.net
# spring.mail.port=587
# spring.mail.username=apikey
# spring.mail.password=YOUR_SENDGRID_API_KEY

# Option 2: Gmail (For development/testing)
# Enable 2FA and create App Password: https://myaccount.google.com/apppasswords
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_EMAIL@gmail.com
spring.mail.password=YOUR_GMAIL_APP_PASSWORD

spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.starttls.required=true
spring.mail.properties.mail.transport.protocol=smtp

# JWT Configuration
# Generate a strong secret: openssl rand -base64 64
jwt.secret=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_FOR_PRODUCTION
jwt.expiration=86400000

# Google OAuth2 Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
spring.security.oauth2.client.registration.google.client-id=YOUR_GOOGLE_CLIENT_ID
spring.security.oauth2.client.registration.google.client-secret=YOUR_GOOGLE_CLIENT_SECRET
spring.security.oauth2.client.registration.google.scope=profile,email
spring.security.oauth2.client.registration.google.redirect-uri=http://localhost:3000

# CORS Configuration (comma-separated list of allowed origins)
cors.allowed.origins=http://localhost:3000,http://localhost:5173

# JPA Configuration
spring.jpa.open-in-view=false
